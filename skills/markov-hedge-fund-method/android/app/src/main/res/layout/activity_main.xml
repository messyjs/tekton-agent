<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Fixed top area: header, source, input, params -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="0dp">

        <!-- Header row: title + settings gear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:background="@color/bg_card_elevated"
                android:contentDescription="Settings"
                android:padding="6dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <!-- Source selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source:"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/sourceSpinner"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@color/bg_card_elevated"
                android:popupBackground="@color/bg_card"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/sourceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp" />

        <!-- Ticker input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/tickerInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@color/bg_card_elevated"
                android:hint="@string/ticker_hint"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:inputType="textCapCharacters"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/analyzeButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/analyze_button"
                android:textColor="@color/bg_primary"
                android:backgroundTint="@color/accent"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- Params row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/years_label" android:textColor="@color/text_dim"
                android:textSize="11sp" android:fontFamily="monospace" android:layout_marginEnd="3dp"/>
            <EditText android:id="@+id/yearsInput" android:layout_width="40dp" android:layout_height="28dp"
                android:background="@color/bg_card_elevated" android:text="@string/default_years"
                android:textColor="@color/text_primary" android:textSize="12sp"
                android:fontFamily="monospace" android:gravity="center" android:inputType="number"
                android:padding="3dp" android:layout_marginEnd="10dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/window_label" android:textColor="@color/text_dim"
                android:textSize="11sp" android:fontFamily="monospace" android:layout_marginEnd="3dp"/>
            <EditText android:id="@+id/windowInput" android:layout_width="40dp" android:layout_height="28dp"
                android:background="@color/bg_card_elevated" android:text="@string/default_window"
                android:textColor="@color/text_primary" android:textSize="12sp"
                android:fontFamily="monospace" android:gravity="center" android:inputType="number"
                android:padding="3dp" android:layout_marginEnd="10dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/threshold_label" android:textColor="@color/text_dim"
                android:textSize="11sp" android:fontFamily="monospace" android:layout_marginEnd="3dp"/>
            <EditText android:id="@+id/thresholdInput" android:layout_width="40dp" android:layout_height="28dp"
                android:background="@color/bg_card_elevated" android:text="@string/default_threshold"
                android:textColor="@color/text_primary" android:textSize="12sp"
                android:fontFamily="monospace" android:gravity="center" android:inputType="numberDecimal"
                android:padding="3dp"/>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border_subtle"/>

        <!-- Tab bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tabRegime"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="REGIME"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@color/bg_card"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:background="@color/bg_primary"/>

            <TextView
                android:id="@+id/tabSetups"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="SETUPS"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@color/bg_primary"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border_subtle"/>
    </LinearLayout>

    <!-- Status text (outside scrollable, above both content areas) -->
    <TextView android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"/>

    <!-- REGIME TAB CONTENT -->
    <ScrollView
        android:id="@+id/regimeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <!-- Source info -->
            <TextView android:id="@+id/sourceInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp"/>

            <!-- Current Regime Banner -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/current_regime_header"
                    android:textColor="@color/accent_dim" android:textSize="11sp"
                    android:fontFamily="monospace" android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/currentRegimeText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text_primary" android:textSize="28sp"
                    android:fontFamily="monospace" android:textStyle="bold"
                    android:gravity="center"/>

                <LinearLayout android:id="@+id/nextProbsRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Transition Matrix card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/transition_matrix_header"
                        android:textColor="@color/accent" android:textSize="13sp"
                        android:fontFamily="monospace" android:textStyle="bold"
                        android:letterSpacing="0.08"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="3x3" android:textColor="@color/text_dim"
                        android:textSize="11sp" android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/matrixGrid"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Persistence diagonal -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/persistence_header"
                    android:textColor="@color/accent_dim" android:textSize="11sp"
                    android:fontFamily="monospace" android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout android:id="@+id/persistenceGrid"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Stationary Distribution -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stationary_header"
                        android:textColor="@color/accent" android:textSize="13sp"
                        android:fontFamily="monospace" android:textStyle="bold"
                        android:letterSpacing="0.08"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="steady state" android:textColor="@color/text_dim"
                        android:textSize="11sp" android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/stationaryGrid"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center"/>
            </LinearLayout>

            <!-- Signal -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/signal_header"
                    android:textColor="@color/accent_dim" android:textSize="11sp"
                    android:fontFamily="monospace" android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp"/>

                <TextView android:id="@+id/signalText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text_primary" android:textSize="24sp"
                    android:fontFamily="monospace" android:textStyle="bold"
                    android:gravity="center"/>

                <TextView android:id="@+id/signalDirection"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:fontFamily="monospace"
                    android:gravity="center" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Walk-forward backtest -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/backtest_header"
                    android:textColor="@color/accent_dim" android:textSize="11sp"
                    android:fontFamily="monospace" android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout android:id="@+id/backtestGrid"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Footer -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/framework_credit"
                android:textColor="@color/accent" android:textSize="11sp"
                android:fontFamily="monospace" android:gravity="center"
                android:layout_marginTop="4dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/disclaimer"
                android:textColor="@color/text_dim" android:textSize="10sp"
                android:fontFamily="monospace" android:gravity="center"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- SETUPS TAB CONTENT -->
    <ScrollView
        android:id="@+id/setupsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/setupsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <!-- Direction banner -->
            <LinearLayout
                android:id="@+id/setupDirectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIRECTION"
                    android:textColor="@color/accent_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/setupDirectionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/setupConvictionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/setupHintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Entry / Stop / Target card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEVELS"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout android:id="@+id/setupLevelsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Position sizing card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POSITION SIZE"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/setupSizePctText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView android:id="@+id/setupSizeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

                <TextView android:id="@+id/setupSizeReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Regime context card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGIME CONTEXT"
                    android:textColor="@color/accent_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout android:id="@+id/setupContextGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not financial advice. Historical stats, not predictions."
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>